# ============ DataMind Agent 配置示例 ============
# 使用方法：复制本文件为 agent/.env，填入真实值。
# agent/.env 含真实凭据，已被 .gitignore 排除，禁止提交或外传。

# 大模型接口（必填）
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选：默认值见 agent/config.py
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# 模型连接/读取超时（秒）及 SDK 最大重试次数
# DATAMIND_LLM_CONNECT_TIMEOUT=10
# DATAMIND_LLM_READ_TIMEOUT=45
# DATAMIND_LLM_MAX_RETRIES=1

# 智能问数专用的只读数据库账号（必填）
# 该账号只应被授予 ADS/DWS 授权表的 SELECT 权限，不授予 FILE/写权限。
# ETL 仍使用各自脚本内的写入账号，两者互不影响。
DATAMIND_QUERY_USER=datamind_ro
DATAMIND_QUERY_PASSWORD=your-readonly-password
# DATAMIND_MYSQL_HOST=localhost
# DATAMIND_MYSQL_PORT=3306
# DATAMIND_QUERY_TIMEOUT_MS=15000
# DATAMIND_BACKEND_URL=http://localhost:8000

# 可选：评论语义洞察的本地 SQLite 索引路径
# 默认 data/review_index/reviews.sqlite3；源文件变化后首次使用会自动重建
# DATAMIND_REVIEW_INDEX_PATH=D:/DataMind/data/review_index/reviews.sqlite3

# MySQL 真实数据接入（可选；不配置令牌时接入接口关闭）
# 在本机生成随机令牌：python -c "import secrets; print(secrets.token_urlsafe(32))"
# DATAMIND_INGEST_TOKEN=replace-with-a-random-token-at-least-32-characters
# shop 对应 backend/sources.local.json 的数据源 ID；密码仅保存在环境变量中。
# DATAMIND_SOURCE_SHOP_PASSWORD=your-source-readonly-password
